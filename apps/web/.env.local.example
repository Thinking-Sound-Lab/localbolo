# Secrets for selling LocalBolo and recording who bought it. Copy this file to
# .env.local (git-ignored) and fill it in. For the live site, set the same
# variables in the Vercel project instead (see README › Deploying).

# Dashboard › Developer › API Keys. Test mode and live mode have separate keys:
# create this one in the mode DODO_PAYMENTS_ENVIRONMENT names, or Dodo answers
# 401 Unauthorized.
DODO_PAYMENTS_API_KEY=

# test_mode or live_mode. Anything else, including leaving it empty, means
# test_mode, so a mistake never charges real cards.
DODO_PAYMENTS_ENVIRONMENT=test_mode

# The LocalBolo product, from Dashboard › Products (pdt_...). Test and live
# mode have separate products, so this changes when you go live.
DODO_PAYMENTS_PRODUCT_ID=

# Signing secret of the webhook that points at https://<your domain>/api/webhooks/dodo
# (Dashboard › Developer › Webhooks).
DODO_PAYMENTS_WEBHOOK_KEY=

# Your Dodo business ID (Dashboard › Settings), for /license, which sends
# buyers to Dodo's customer portal to look up a lost license key.
DODO_PAYMENTS_BUSINESS_ID=

# The record of who bought LocalBolo (see README › Purchases), from the
# Supabase project's settings: the project URL (https://<ref>.supabase.co) and
# a secret key (API Keys › Secret keys, sb_secret_…). The secret key can read
# and write every purchase, so it stays on the server: never prefix it
# NEXT_PUBLIC_.
SUPABASE_URL=
SUPABASE_SECRET_KEY=

# Downloads and app updates. /download and the update feed (/appcast.xml) read
# the Mac app's releases from the public GitHub repository. Optional: without
# a token GitHub allows 60 requests an hour per IP address, which a shared
# hosting IP can run out of; with one, 5,000 an hour. Use a fine-grained
# personal access token with read-only access to public repositories
# (GitHub › Settings › Developer settings).
GITHUB_RELEASES_TOKEN=
