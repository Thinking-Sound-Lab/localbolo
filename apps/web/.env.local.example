# Secrets for selling LocalBolo through Dodo Payments. Copy this file to
# .env.local (git-ignored) and fill it in. In production, set the same
# variables in your hosting provider's environment settings instead.

# Dashboard › Developer › API Keys. Test keys start with dodo_test_, live keys
# with dodo_live_.
DODO_PAYMENTS_API_KEY=

# test_mode or live_mode. Anything else, including leaving it empty, means
# test_mode, so a mistake never charges real cards.
DODO_PAYMENTS_ENVIRONMENT=test_mode

# The LocalBolo product, from Dashboard › Products (pdt_...). Test and live
# mode have separate products, so this changes when you go live.
DODO_PAYMENTS_PRODUCT_ID=

# Signing secret of the webhook that points at https://<your domain>/api/webhooks/dodo
# (Dashboard › Developer › Webhooks).
DODO_PAYMENTS_WEBHOOK_KEY=

# Your Dodo business ID (Dashboard › Settings), for /license, which sends
# buyers to Dodo's customer portal to look up a lost license key.
DODO_PAYMENTS_BUSINESS_ID=

# Downloads and app updates. /download and the update feed (/appcast.xml) read
# the Mac app's GitHub releases. Optional once the repository is public, but
# recommended: without a token GitHub allows only 60 requests an hour. Use a
# fine-grained personal access token with read-only "Contents" access to
# Thinking-Sound-Lab/localbolo (GitHub › Settings › Developer settings).
GITHUB_RELEASES_TOKEN=
