// The development environment, used by the Debug configuration.
//
// A separate bundle identifier gives the development build its own settings,
// permissions and logs, so it can be installed next to the production app.
// Downloaded models are shared between the two.

#include "Base.xcconfig"

PRODUCT_NAME = LocalBolo Dev
PRODUCT_BUNDLE_IDENTIFIER = com.localbolo.LocalBolo.dev
INFOPLIST_KEY_CFBundleDisplayName = LocalBolo Dev
ASSETCATALOG_COMPILER_APPICON_NAME = AppIcon-Dev

// Ad-hoc ("Sign to Run Locally") so anyone can build, unless Local.xcconfig
// sets a signing identity.
CODE_SIGN_STYLE = Automatic
CODE_SIGN_IDENTITY = -

// Optional, git-ignored overrides such as your signing team. See Local.xcconfig.example.
#include? "Local.xcconfig"
