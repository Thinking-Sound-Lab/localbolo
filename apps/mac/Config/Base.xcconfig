// Build settings for the LocalBolo app shared by every environment.
// Development.xcconfig and Production.xcconfig include this file and add
// what differs between them.

PRODUCT_MODULE_NAME = LocalBolo
MARKETING_VERSION = 0.2.0
CURRENT_PROJECT_VERSION = 1

// The website the app links to and reads updates from. It's the Vercel
// project's own address until the localbolo.app domain is set up; change it
// together with NEXT_PUBLIC_SITE_URL in apps/web/.env.production.
// (`/$()/` stops xcconfig from reading `//` as a comment.)
WEBSITE_URL = https:/$()/localbolo.vercel.app

// Speech models run on the Neural Engine, so only Apple Silicon is supported.
MACOSX_DEPLOYMENT_TARGET = 15.0
ARCHS = arm64

// Info.plist, generated from these settings and merged with Config/Info.plist.
GENERATE_INFOPLIST_FILE = YES
INFOPLIST_FILE = Config/Info.plist
INFOPLIST_KEY_LSApplicationCategoryType = public.app-category.productivity
INFOPLIST_KEY_NSMicrophoneUsageDescription = LocalBolo listens only while you hold the fn key, and transcribes your speech on this Mac.
// Menu bar app: no Dock icon and no main menu.
INFOPLIST_KEY_LSUIElement = YES

// Embedded frameworks, such as Sparkle, live in Contents/Frameworks.
LD_RUNPATH_SEARCH_PATHS = $(inherited) @executable_path/../Frameworks

// Assets
ASSETCATALOG_COMPILER_GLOBAL_ACCENT_COLOR_NAME = AccentColor

// Swift
SWIFT_VERSION = 6.0
SWIFT_DEFAULT_ACTOR_ISOLATION = MainActor
SWIFT_APPROACHABLE_CONCURRENCY = YES
SWIFT_UPCOMING_FEATURE_MEMBER_IMPORT_VISIBILITY = YES
SWIFT_EMIT_LOC_STRINGS = YES

// Not sandboxed: pasting into other apps needs Accessibility access, which
// sandboxed apps can't use to send keystrokes.
CODE_SIGN_ENTITLEMENTS = Config/LocalBolo.entitlements
ENABLE_HARDENED_RUNTIME = YES
